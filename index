      <div class="sheet-container">
        <img src="https://www.dropbox.com/scl/fi/7q8lf9233yt2ia10z8xrj/C26_04-Charsheet-A-png.png?rlkey=lzdkpbdb22ta4hjqjr6qrzur1&st=l3ekwg3j&raw=1" alt="Drake Character Sheet" class="sheet-img">
