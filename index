        </div>
      </div>
    </div>
  </section>

  <section id="project" class="other-page">
    <div class="project-layout">
      <div class="project-sidebar">
        <button class="project-menu-btn active-menu lang-text" onclick="switchProjectTab('lore', this)" data-id="Lore Song" data-en="Lore Song">Lore Song</button>
        <button class="project-menu-btn lang-text" onclick="switchProjectTab('cover', this)" data-id="Cover Song" data-en="Cover Song">Cover Song</button>
        <button class="project-menu-btn lang-text" onclick="switchProjectTab('babu', this)" data-id="My Babu" data-en="My Babu">My Babu</button>
        <button class="project-menu-btn lang-text" onclick="switchProjectTab('merch', this)" data-id="Merch" data-en="Merch">Merch</button>
        <button class="project-menu-btn lang-text" onclick="switchProjectTab('fanart', this)" data-id="Fanart" data-en="Fanart">Fanart</button>
      </div>
      <div class="project-content-raw">
        
        <div id="panel-lore" class="project-grid-panel active-panel">
