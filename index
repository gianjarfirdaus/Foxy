  <script>
    // =========================================================================
    // API LINK GOOGLE APPS SCRIPT
    // =========================================================================
    const API_URL = "https://script.google.com/macros/s/AKfycbxmgq4StyIcCiNmdXLvNw6X7jn8u7KGsCbB5omsgkbskHhyYPwgCh9WKllt9PboLn0FOg/exec";


    const cursor = document.getElementById('custom-cursor');
    const navbar = document.getElementById('navbar');
    
    document.addEventListener('mousemove', (e) => {
      cursor.style.left = e.clientX + 'px';
      cursor.style.top = e.clientY + 'px';
      
      if (window.innerWidth > 768) {
        if (e.clientY <= 100) {
            navbar.classList.remove('navbar-hidden');
        } else {
            navbar.classList.add('navbar-hidden');
        }
      } else {
        navbar.classList.remove('navbar-hidden');
      }
    });

    const bgMusic = document.getElementById('bgMusic');
    const foxyVoice = document.getElementById('foxyVoice');
    const drakeVoice = document.getElementById('drakeVoice');
    const navMusicBtn = document.getElementById('navMusicBtn');
    const btnBackFoxy = document.getElementById('btnBackFoxy');
    const btnBackDrake = document.getElementById('btnBackDrake');
    
    // Variabel bahasa default
    let currentLang = 'id'; 
    
    // Objek penyimpan link audio berdasarkan bahasa
    const audioLinks = {
        id: {
            foxy: "https://www.dropbox.com/scl/fi/ntncwquf39vey2e6ida0u/pocis-en.mp3?rlkey=z5a38ndt9ukwrtv6oneycjxyr&st=ekn36tye&raw=1",
            drake: "https://www.dropbox.com/scl/fi/jw4uthki9o30inqplnwkb/drake-cocot-2.mp3?rlkey=53u0h3ypz60ywqbq58wu1ocp1&st=e6fbc1r8&raw=1"
        },
        en: {
            foxy: "https://www.dropbox.com/scl/fi/3g969s4oi2mde03o2d949/pocis-indo.mp3?rlkey=uabj8scuc43zm9mcag1tnjdgk&st=g3vl9eoz&raw=1",
            drake: "https://www.dropbox.com/scl/fi/rzul8k26g9z79i0titlst/drake-EN.mp3?rlkey=swvd415ibov0v1vovyg55s7ww&st=n7c8srk5&raw=1"
        }
    };
    
    window.addEventListener('DOMContentLoaded', () => {
      const playPromise = bgMusic.play();
      if (playPromise !== undefined) {
        playPromise.then(() => {
          navMusicBtn.innerHTML = '🎵';
        }).catch((error) => {
          console.log("Autoplay diblokir oleh browser.");
          navMusicBtn.innerHTML = '🔇';
        });
      }
    });

    navMusicBtn.addEventListener('click', () => {
      if (bgMusic.paused) {
        bgMusic.play().then(() => {
          navMusicBtn.innerHTML = '🎵';
        }).catch(err => console.log("Gagal memutar audio: ", err));
      } else {
        bgMusic.pause();
        navMusicBtn.innerHTML = '🔇';
      }
    });
    
    function playFoxyVoice() {
        bgMusic.pause();
        navMusicBtn.innerHTML = '🔇';
        navbar.classList.add('disabled-nav');
        btnBackFoxy.classList.add('disabled-nav');
        
        foxyVoice.src = audioLinks[currentLang].foxy;
        foxyVoice.play().catch(err => {
            console.log("Suara Foxyria gagal diputar:", err);
            navbar.classList.remove('disabled-nav');
            btnBackFoxy.classList.remove('disabled-nav');
        });
    }

    foxyVoice.addEventListener('ended', () => {
        navbar.classList.remove('disabled-nav');
        btnBackFoxy.classList.remove('disabled-nav');
        bgMusic.play().then(() => {
            navMusicBtn.innerHTML = '🎵';
        }).catch(err => console.log(err));
    });

    function playDrakeVoice() {
        bgMusic.pause();
        navMusicBtn.innerHTML = '🔇';
        navbar.classList.add('disabled-nav');
        btnBackDrake.classList.add('disabled-nav');
        
        drakeVoice.src = audioLinks[currentLang].drake;
        drakeVoice.play().catch(err => {
            console.log("Suara Drake gagal diputar:", err);
            navbar.classList.remove('disabled-nav');
            btnBackDrake.classList.remove('disabled-nav');
        });
    }

    drakeVoice.addEventListener('ended', () => {
        navbar.classList.remove('disabled-nav');
        btnBackDrake.classList.remove('disabled-nav');
        bgMusic.play().then(() => {
            navMusicBtn.innerHTML = '🎵';
        }).catch(err => console.log(err));
    });
    
    function switchPage(pageId, event) {
      if(event) event.preventDefault();
      if(navbar.classList.contains('disabled-nav')) return;

      document.querySelectorAll('section').forEach(sec => sec.classList.remove('active'));
      document.getElementById(pageId).classList.add('active');
      document.getElementById('navLinks').classList.remove('active');
      navbar.classList.remove('navbar-hidden');
      
      if(pageId === 'about') { switchAboutView('about-main'); }
    }
    
    function switchAboutView(viewId) {
      document.querySelectorAll('.about-view').forEach(view => { view.classList.remove('active-view'); });
      document.getElementById(viewId).classList.add('active-view');
      
      if(viewId === 'sheet-foxy') {
          playFoxyVoice();
      } else if (viewId === 'sheet-drake') {
          playDrakeVoice();
      }
    }

    function toggleMenu() { document.getElementById('navLinks').classList.toggle('active'); }
    
    function switchProjectTab(tabName, btnElement) {
      document.querySelectorAll('.project-grid-panel, .project-single-panel').forEach(panel => { panel.classList.remove('active-panel'); });
      document.querySelectorAll('.project-menu-btn').forEach(btn => { btn.classList.remove('active-menu'); });
      document.getElementById('panel-' + tabName).classList.add('active-panel');
      btnElement.classList.add('active-menu');
    }

    function toggleLanguage() {
      currentLang = currentLang === 'en' ? 'id' : 'en';
      document.querySelectorAll('.lang-text').forEach(el => {
        if(el.tagName.toLowerCase() !== 'img') { 
            el.innerHTML = currentLang === 'id' ? el.getAttribute('data-id') : el.getAttribute('data-en'); 
        }
      });
    }

    // ================================================================
    // SISTEM QNA VIA FETCH API (UNTUK GITHUB)
    // ================================================================
    const qnaForm = document.getElementById('qnaForm');
    const qnaMarquee = document.getElementById('qnaMarquee');
    const btnSubmit = document.getElementById('btnSubmitQna');
    
    function loadRecentQnA() {
      if (!API_URL || API_URL === "MASUKKAN_LINK_WEB_APP_ANDA_DISINI") return;
      
      fetch(API_URL)
        .then(response => response.json())
        .then(data => {
          if (!data || data.length === 0) { 
            qnaMarquee.innerHTML = '<span class="qna-item">Belum ada pertanyaan. Jadilah yang pertama!</span>'; 
            return; 
          }
          let htmlKonten = ''; 
          data.forEach(item => { 
            htmlKonten += `<span class="qna-item"><strong>${item.nama}</strong>: "${item.pertanyaan}"</span>`; 
          });
          qnaMarquee.innerHTML = htmlKonten;
        })
        .catch(err => console.error("Gagal memuat QnA:", err));
    }
    loadRecentQnA();
    
    if (qnaForm) {
      qnaForm.addEventListener('submit', (e) => {
        e.preventDefault();
        if (!API_URL || API_URL === "MASUKKAN_LINK_WEB_APP_ANDA_DISINI") { 
            alert('Ganti API_URL terlebih dahulu dengan link Web App Google Apps Script Anda!'); 
            return; 
        }
        
        const btnTextAwal = btnSubmit.innerHTML; 
        btnSubmit.innerHTML = 'Mengirim...'; 
        btnSubmit.disabled = true;
        
        const payload = {
          nama: document.getElementById('qnaNama').value,
          email: document.getElementById('qnaEmail').value,
          pertanyaan: document.getElementById('qnaPertanyaan').value
        };

        fetch(API_URL, {
          method: 'POST',
          headers: {
            'Content-Type': 'text/plain;charset=utf-8',
          },
          body: JSON.stringify(payload)
        })
        .then(response => response.json())
        .then(result => {
          if(result.status === "success") { 
            alert('Pertanyaan berhasil dikirim!'); 
            qnaForm.reset(); 
            loadRecentQnA(); 
          } else { 
            alert('Gagal menyimpan: ' + result.message); 
          }
        })
        .catch(err => {
          // Fallback jika browser memblokir respon JSON (CORS) tapi data berhasil masuk ke spreadsheet
          alert('Pertanyaan terkirim!');
          qnaForm.reset(); 
          setTimeout(loadRecentQnA, 2000); 
        })
        .finally(() => {
          btnSubmit.innerHTML = btnTextAwal; 
          btnSubmit.disabled = false;
        });
      });
    }

    let currentSlideIndex = 0;
    function changeSlide(direction) {
        const slides = document.querySelectorAll('.fanart-slide');
        const totalSlides = slides.length;
        if (totalSlides === 0) return;
        slides[currentSlideIndex].classList.remove('active-slide');
        currentSlideIndex += direction;
        if (currentSlideIndex >= totalSlides) {
            currentSlideIndex = 0;
        } else if (currentSlideIndex < 0) {
            currentSlideIndex = totalSlides - 1;
        }
        slides[currentSlideIndex].classList.add('active-slide');
    }
  </script>
</body>
