  <section id="contact" class="other-page">
    <div class="content-box">
      <h2 class="lang-text" data-id="Tanya & Jawab (QnA)" data-en="Questions & Answers">Tanya & Jawab (QnA)</h2>
      <p class="lang-text" data-id="Kirimkan pertanyaanmu, dan lihat 5 pertanyaan terbaru di bawah!" data-en="Send your questions and see the 5 latest below!">Kirimkan pertanyaanmu, dan lihat 5 pertanyaan terbaru di bawah!</p>
      <form id="qnaForm" class="qna-form">
        <input type="text" id="qnaNama" name="nama" placeholder="Nama Anda / Your Name" required>
        <input type="email" id="qnaEmail" name="email" placeholder="Email Aktif (Privasi Aman) / Active Email" required>
        <textarea id="qnaPertanyaan" name="pertanyaan" placeholder="Tulis pertanyaanmu di sini... / Write your question..." required></textarea>
        <button type="submit" id="btnSubmitQna" class="lang-text" data-id="Kirim Pertanyaan" data-en="Send Question">Kirim Pertanyaan</button>
      </form>
      <div class="marquee-container"><div class="marquee-content" id="qnaMarquee"><span class="qna-item">Memuat 5 pertanyaan terbaru...</span></div></div>
    </div>
